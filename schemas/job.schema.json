{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "objective", "acceptanceCriteria", "executionMode", "model", "reasoningEffort", "modelSource"],
  "properties": {
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"
    },
    "requestedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human", "tool"],
      "properties": {
        "human": { "type": "string", "minLength": 1, "maxLength": 100 },
        "tool": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "scope": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "executionMode": { "type": "string", "enum": ["read_only", "draft_pr"] },
    "model": { "type": "string", "enum": ["gpt-5.6-sol", "gpt-6-astra"] },
    "reasoningEffort": { "type": "string", "enum": ["high", "max"] },
    "modelSource": { "type": "string", "minLength": 1, "maxLength": 50 },
    "githubReferences": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 9999999 }
    },
    "controllerContext": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1, "maxLength": 8000 }
    }
  }
}
